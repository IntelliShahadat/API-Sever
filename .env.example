# --- MySQL connection ---
# Local dev example:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hr_chatbot

# When you move to a free cloud MySQL (e.g. Aiven, Railway, PlanetScale-alt, FreeSQLDatabase)
# just replace the 4 values above with the ones they give you - no code changes needed.

# --- JWT settings ---
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Logging ---
# Folder (relative to api_server/) where per-session log files are written.
LOG_DIR=logs
# Max number of session log files kept at once - oldest is deleted when exceeded.
MAX_LOG_FILES=20
